{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "globalSetup": "<rootDir>/e2e/global-setup.ts",
  "globalTeardown": "<rootDir>/e2e/global-teardown.ts",
  "setupFiles": ["<rootDir>/e2e/ambiente.ts"],
  "testTimeout": 60000,
  "maxWorkers": 1
}
