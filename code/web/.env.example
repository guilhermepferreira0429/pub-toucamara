NEXT_PUBLIC_API_URL=http://localhost:3001
# Agente de voz no browser (plano B da demo: QR code abre a chamada no telemóvel).
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Município do site (chat e chamada no browser).
NEXT_PUBLIC_MUNICIPIO=guimaraes
# Nome do município e linha da câmara, mostrados na chamada pelo browser.
NEXT_PUBLIC_MUNICIPIO_NOME=Guimarães
NEXT_PUBLIC_TELEFONE_CAMARA=
# Endereço público do site (o QR code do slide aponta para ${NEXT_PUBLIC_SITE_URL}/ligar).
NEXT_PUBLIC_SITE_URL=

# Acessibilidade (lib/acessibilidade.ts, página /acessibilidade).
# Contacto para reportar problemas de acessibilidade (por omissão, o telefone da câmara).
NEXT_PUBLIC_ACESSIBILIDADE_EMAIL=
NEXT_PUBLIC_ACESSIBILIDADE_TELEFONE=
# Vídeos em Língua Gestual Portuguesa, por tipo de página (JSON). Sem vídeo, nada aparece.
# Ex.: {"processo":"https://…/processo.mp4","acessibilidade":{"url":"https://…/a.mp4","legendas":"https://…/a.vtt"}}
NEXT_PUBLIC_LGP_VIDEOS=
# Atendimento por videochamada com intérprete de LGP (só se a câmara o tiver).
NEXT_PUBLIC_LGP_VIDEOCHAMADA_URL=
NEXT_PUBLIC_LGP_VIDEOCHAMADA_NOME=
NEXT_PUBLIC_LGP_VIDEOCHAMADA_HORARIO=

# Mapas (docs/MAPAS.md). Token PÚBLICO do Mapbox (começa por "pk."), com restrição de URL
# aos domínios da demo no dashboard do Mapbox. Vazio: todos os mapas usam Leaflet + OpenStreetMap.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Estilo: "standard" (por omissão: edifícios 3D, cores da marca), "standard-satellite" ou um mapbox://styles/…
NEXT_PUBLIC_MAPBOX_ESTILO=
