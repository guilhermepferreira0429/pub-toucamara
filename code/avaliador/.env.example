# Mesmo Postgres da API (esquema avaliacao, migração 0022 da API).
DB_HOST=localhost
DB_PORT=54330
DB_USER=toucamara
DB_PASSWORD=
DB_NAME=toucamara
DB_SSL=false

# Juiz e gabarito. Sem chave: executar continua a funcionar (só grava respostas).
ANTHROPIC_API_KEY=
