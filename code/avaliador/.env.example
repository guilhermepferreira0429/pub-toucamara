# O mesmo da API: sem ele o chat limita a 20 sessões novas por IP em 10 min.
AGENTE_SEGREDO=
ELEVENLABS_API_KEY=

# Onde ficam capturas de ecrã e relatórios.
PASTA_SAIDA=./saida
